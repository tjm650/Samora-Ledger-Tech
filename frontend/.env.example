# Server-only connection to the Render FastAPI service. Never use NEXT_PUBLIC_ for these.
SAMORA_API_URL=https://YOUR_RENDER_SERVICE.onrender.com
SAMORA_API_KEY=YOUR_RENDER_API_KEY

# Supabase Auth for executive staff sign-in (publishable key is safe for browser use).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
