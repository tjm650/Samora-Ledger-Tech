# Server-only connection to the Render FastAPI service. Never use NEXT_PUBLIC_ for these.
SAMORA_API_URL=https://YOUR_RENDER_SERVICE.onrender.com
SAMORA_API_KEY=YOUR_RENDER_API_KEY

# Optional: only needed if another approved browser-side feature uses Supabase directly.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
